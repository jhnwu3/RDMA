# ── Parent match sweep (ai1 = best baseline from prior run) ──────────────────
combo_tag = dc0_eq0_ai1_pm1
arguments = $(combo_tag) --no-decompose_compound --no-extract_qualified --allow_inheritance --parent_match --no-exhaustive
queue

combo_tag = dc0_eq0_ai1_pm0
arguments = $(combo_tag) --no-decompose_compound --no-extract_qualified --allow_inheritance --no-parent_match --no-exhaustive
queue

# ── Exhaustive sweep (ai1+pm1 = best baseline) ───────────────────────────────
combo_tag = dc0_eq0_ai1_pm1_ex1
arguments = $(combo_tag) --no-decompose_compound --no-extract_qualified --allow_inheritance --parent_match --exhaustive
queue

combo_tag = dc0_eq0_ai1_pm1_ex0
arguments = $(combo_tag) --no-decompose_compound --no-extract_qualified --allow_inheritance --parent_match --no-exhaustive
queue
