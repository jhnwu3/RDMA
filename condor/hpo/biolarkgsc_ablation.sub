# biolarkgsc_ablation.sub — ablation sweep for mistral_24b
# Flags: decompose_compound (dc), extract_qualified (eq), allow_inheritance (ai), parent_match (pm)
# 0 = flag off (--no-X), 1 = flag on (--X)
executable = /home/johnwu3/projects/rare_disease/workspace/condor/hpo/run_biolarkgsc_ablation.sh

Requirements = (Machine == "sunlab-c02.cs.illinois.edu")

universe       = vanilla
request_cpus   = 16
request_memory = 32GB
request_gpus   = 1

log    = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/hpo/ablation/mistral_24b/$(combo_tag).$(Cluster).$(Process).log
output = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/hpo/ablation/mistral_24b/$(combo_tag).$(Cluster).$(Process).out
error  = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/hpo/ablation/mistral_24b/$(combo_tag).$(Cluster).$(Process).err

