# ablation_mistral24b.sub — mistral_24b BioLarkGSC ablation sweep
#
# Reference baseline (NOT re-run): results/biolarkgsc/mistral_24b_predictions.jsonl
#   Settings: retrieval extractor, v4 verifier, top_k=20, window=0, --allow_inheritance
#   Performance: P=56.51  R=55.32  F1=55.91
#
# Groups:
#   A: top_k sweep            (5, 10, 50, 100)
#   B: verifier ablation      (v1=direct-only, v3=no-lab)
#   C: fuzzy threshold sweep  (0.95, 0.90, 0.80, 0.60)
#   D: context window sweep   (1, 2, 5, 10 sentences)
#   E: text membership check  (require_text_match)

executable = /home/johnwu3/projects/rare_disease/workspace/condor/hpo/run_ablation_mistral24b.sh

Requirements = (Machine == "sunlab-c01.cs.illinois.edu")

universe       = vanilla
request_cpus   = 16
request_memory = 32GB
request_gpus   = 1

log    = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/ablation_mistral24b/$(job_name)/$(Cluster).$(Process).log
output = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/ablation_mistral24b/$(job_name)/$(Cluster).$(Process).out
error  = /home/johnwu3/projects/rare_disease/workspace/logs/biolarkgsc/ablation_mistral24b/$(job_name)/$(Cluster).$(Process).err

