# rdrag_raredis.sub — submits one RDRAG RareDis baseline job per model; each job is scheduled independently
executable = /home/johnwu3/projects/rare_disease/workspace/condor/rare_disease/run_rdrag_raredis.sh

Requirements = (Machine == "sunlab-c01.cs.illinois.edu")

universe       = vanilla
request_cpus   = 4
request_memory = 32GB
request_gpus   = 1

log    = /home/johnwu3/projects/rare_disease/workspace/logs/raredis/rdrag/$(model_type)/$(Cluster).$(Process).log
output = /home/johnwu3/projects/rare_disease/workspace/logs/raredis/rdrag/$(model_type)/$(Cluster).$(Process).out
error  = /home/johnwu3/projects/rare_disease/workspace/logs/raredis/rdrag/$(model_type)/$(Cluster).$(Process).err

model_type = llama3_8b
arguments  = $(model_type)
queue

model_type = mistral_24b
arguments  = $(model_type)
queue

model_type = llama3_70b
arguments  = $(model_type)
queue

model_type = qwen3_32b
arguments  = $(model_type)
queue
