# eval_bert.sub — temporary helper to submit evaluation jobs for BERT baselines:
#   - code track: biobert_mrc, bioclinicalbert_ner, i2b2_rd
#   - text track: i2b2_rd only

# Code-track eval jobs
executable = /home/johnwu3/projects/rare_disease/workspace/condor/rare_disease/run_eval_mimic3_rd_mining.sh

Requirements = (Machine == "sunlab-c02.cs.illinois.edu")

universe       = vanilla
request_cpus   = 16
request_memory = 32GB
request_gpus   = 1

log    = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining/bert/$(model_type).$(Cluster).$(Process).log
output = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining/bert/$(model_type).$(Cluster).$(Process).out
error  = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining/bert/$(model_type).$(Cluster).$(Process).err

arguments = $(model_type) $(approach)

approach = biobert_mrc
model_type = biobert_mrc
queue

approach = bioclinicalbert_ner
model_type = bioclinicalbert_ner
queue

approach = i2b2_rd
model_type = i2b2_rd
queue

# Text-track eval jobs (i2b2 only)
executable = /home/johnwu3/projects/rare_disease/workspace/condor/rare_disease/run_eval_mimic3_rd_mining_text.sh

log    = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining_text/bert/$(model_type).$(Cluster).$(Process).log
output = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining_text/bert/$(model_type).$(Cluster).$(Process).out
error  = /home/johnwu3/projects/rare_disease/workspace/logs/mimic3_rd_mining_text/bert/$(model_type).$(Cluster).$(Process).err

arguments = $(model_type) $(approach)

approach = i2b2_rd
model_type = i2b2_rd
queue
