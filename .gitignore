# --- Secrets / credentials -------------------------------------------------
.env
.env.*
azure_openai_config.json
scripts/azure_openai_config.json
# The committed template is scripts/azure_openai_config.example.json

# --- Local working data ----------------------------------------------------
# Large vector stores, ontologies, checkpoints and intermediate outputs.
# See public_data/ for the redistributable benchmark data.
# Leading slash anchors this to the repo root — an unanchored `data/` also
# matches nested directories such as scripts/data/.
/data/

# Derived files regenerated by the dataset loaders' prepare_metadata()
public_data/*/texts.csv
public_data/*/annotations.csv
public_data/*/phenotypes.csv
public_data/*/relations.csv

# --- Logs / build artifacts ------------------------------------------------
*.log
*.out
*.pyc
__pycache__/
.ipynb_checkpoints/

# --- OS cruft --------------------------------------------------------------
.DS_Store

# NOTE: shell scripts are intentionally NOT ignored. A previous blanket
# `*.sh` rule silently excluded every runner script in the repo, including
# the ones the README told users to run.

# Credentialed working copies rebuilt by scripts/data/rehydrate_mimic_text.py
rehydrated/

# Packaging build artifacts
*.egg-info/
build/
dist/
